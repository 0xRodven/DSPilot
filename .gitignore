# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pyc
.artifacts/
scraper/__pycache__/
scraper/data/

# Shell scripts (except Claude hooks + versioned scripts)
*.sh
!.claude/hooks/**/*.sh
!scripts/amazon-core-sync.sh
!scripts/run-amazon-unified.sh
!scripts/run-concessions-pipeline.sh

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.secrets

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/
.superpowers/
.claude/scheduled_tasks.lock
.vscode/

# meta-harness runtime artifacts
meta-harness/candidates/*/runs/
meta-harness/candidates/*/score.json
meta-harness/candidates/*/trace-index.json
meta-harness/logs/*.jsonl
meta-harness/logs/*.json
meta-harness/offline-traces/*
meta-harness/tmp/
meta-harness/.venv/
meta-harness/__pycache__/
meta-harness/scripts/__pycache__/
meta-harness/baseline_harness/runs/
meta-harness/baseline_harness/score.json
meta-harness/scripts/.empty_plugins/
